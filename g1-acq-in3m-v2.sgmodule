#!name=G1 ACQ IN 3M v2
#!desc=India 3-month intro build v2. Target SKU com.google.gemini.2tb.ai.m.3month_ip_99p. Open plans inside the Gemini app so StoreKit can resolve that bundle. Patched for the com.google.gemini namespace; HTML pattern hint removed so the report form accepts it.
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/Rulanv/g1-acq-in3m@main/g1-acq-v2.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/Rulanv/g1-acq-in3m@main/g1-sku-report-v2.js

[MITM]
hostname = %APPEND% one.google.com
